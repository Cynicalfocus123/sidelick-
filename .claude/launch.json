{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sidelick-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "sidelick-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dist/main.js"
      ],
      "cwd": "backend",
      "port": 4000
    }
  ]
}